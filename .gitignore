# generated by the flow, re-derivable from the sources -- 7.2 MB of it
*.blif

# the downloaded oss-cad-suite tarball: 13.7 MB of someone else's release
*.tgz
*.tar.gz

# run directories: each is a full copy of the flow for one design
run/
run1/
determinism/
probe_ev/
diag/
work/

# logs
*.log
__pycache__/
*.py[cod]

# no token, key or database in this repo
*.db
*.db-shm
*.db-wal
.git-credentials

# physical-flow run directories: per-design logs and intermediate TCL are
# regenerated by agentic/physflow.py from the RTL, so they are inputs to
# nothing. phys/results.json and the GDS are kept -- those are the result.
phys/*/logs/
phys/*/syn.ys
phys/*/phys.tcl
phys/*/def2gds.tcl
phys/*/drc.tcl

# search scratch: hundreds of per-candidate directories, re-derivable from the
# generators, and the summary of every one of them is already in results.json
agent/*/s*/
evolve/*/work/
evolve/*/g0_*/
evolve/*/g1_*/
random/*/r*/
random_free/*/r*/
random_legal/*/r*/

# the flow's own re-runnable working copies
flow/*.blif
flow/*.log
cec/*.blif
phys/probe_*.tcl

# the vendored KiCad footprint library: 96 MB of someone else's data, cloned not
# committed, with its own LICENSE. Re-clone with:
#   git clone --depth 1 https://github.com/KiCad/kicad-footprints vendor/kicad-footprints
vendor/

# the parsed footprint index: 8.7 MB, regenerated from vendor/ by
# agentic/packflow.py::library() in a few seconds
pack/lib_index*.json

# per-design substrate run directories: Gerbers are results, scribble is not
pack/*/logs/

# debugging scratch from this session: transcripts and one-off drivers
test/*.out
test/dbg*.py
test/dbg*.json
test/run_batch.py
